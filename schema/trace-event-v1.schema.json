{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarsLuay/trace/schema/trace-event-v1.schema.json",
  "title": "Trace event v1",
  "description": "Minimal, language-neutral execution event. Correlation identifiers are implementation metadata and must not be shown as user payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "executionId",
    "invocationId",
    "parentInvocationId",
    "sequence",
    "emittedAt",
    "event",
    "function",
    "subsystem",
    "language",
    "runtime",
    "source"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/id" },
    "executionId": { "$ref": "#/$defs/id" },
    "invocationId": { "$ref": "#/$defs/id" },
    "parentInvocationId": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "sequence": { "$ref": "#/$defs/sequence" },
    "emittedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "event": { "enum": ["enter", "exit", "fail"] },
    "function": { "$ref": "#/$defs/name" },
    "subsystem": { "$ref": "#/$defs/name" },
    "language": { "$ref": "#/$defs/name" },
    "runtime": { "$ref": "#/$defs/name" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "line", "column", "revision", "buildId", "sourceIndexId"],
      "properties": {
        "projectPath": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$)).+$"
        },
        "line": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "column": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "revision": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "buildId": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "sourceIndexId": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sequence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
